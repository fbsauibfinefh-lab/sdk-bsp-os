{
  "run_id": "k210-rtthread-plan-driven-v2.2",
  "workspace": "workspace",
  "ir_store": "workspace/ir",
  "ingestor": {"mode": "hybrid"},
  "sdk": {
    "id": "kendryte-k210-standalone-sdk-0.5.6",
    "path": "sdk/k210/source"
  },
  "resolver": {
    "method": "operation-lambdamart",
    "model_path": "models/runtime/k210-operation-lambdamart-h03-eq-r1-full-v2.2.json",
    "binding_decoder": "signature-family",
    "operation_min_margin": 0.0,
    "capabilities": ["clock", "interrupt", "uart", "gpio", "timer"],
    "threshold": 0.42,
    "top_k": 1024
  },
  "toolchain": {
    "architecture": "riscv64",
    "abi": "lp64f",
    "bin": "toolchains/riscv-none-embed-gcc-10.2.0/bin"
  },
  "closure": {
    "target": {"chip": "k210", "core": "riscv64", "entry_symbols": ["_start"]}
  },
  "backend": {
    "type": "rtthread",
    "board": "k210",
    "sdk_profile": "k210",
    "rtthread_root": "third_party/rt-thread",
    "output": "workspace/generated/k210-rtthread-lambdamart",
    "disabled_rtthread_features": ["RT_USING_SMP"],
    "devices": {
      "uart": [
        {"name": "bspuart1", "channel": 0, "baud_rate": 115200},
        {"name": "bspuart2", "channel": 1, "baud_rate": 115200}
      ],
      "pin": {"name": "bsppin", "max_pins": 32},
      "hwtimer": [
        {"name": "bsptim0", "device": 0, "channel": 0, "frequency": 1000000}
      ]
    },
    "validation": {
      "binding_validation": true,
      "firmware_build_id": "operation-lambdamart-plan-driven-v2.2-rtthread",
      "uart": "bspuart1",
      "uart_channel": 0,
      "uart_tx_fpioa_io": 7,
      "uart_rx_fpioa_io": 6,
      "hwtimer": "bsptim0",
      "gpio_fpioa_io": 8,
      "gpio_binding_pin": 29,
      "gpio_input_fpioa_io": 9,
      "gpio_input_binding_pin": 28
    }
  },
  "build": {
    "jobs": 8,
    "max_iterations": 3
  },
  "evaluation": {
    "ground_truth": "experiments/k210-ground-truth.json",
    "run_ablations": true
  }
}
