{
  "run_id": "k210-zephyr-plan-driven-v2.2",
  "workspace": "workspace",
  "ir_store": "workspace/ir",
  "ingestor": {"mode": "hybrid"},
  "sdk": {
    "id": "kendryte-k210-standalone-sdk-0.5.6",
    "path": "sdk/k210/source"
  },
  "resolver": {
    "method": "operation-lambdamart",
    "model_path": "models/runtime/k210-operation-lambdamart-h03-eq-r1-full-v2.2.json",
    "binding_decoder": "signature-family",
    "operation_min_margin": 0.0,
    "capabilities": ["clock", "interrupt", "uart", "gpio", "timer"],
    "threshold": 0.42,
    "top_k": 1024
  },
  "toolchain": {
    "architecture": "riscv64",
    "abi": "lp64",
    "bin": "toolchains/xpack-riscv-none-elf-gcc-14.2.0-3/bin"
  },
  "closure": {
    "target": {"chip": "k210", "core": "riscv64", "entry_symbols": ["_start"]}
  },
  "backend": {
    "type": "zephyr",
    "board": "k210",
    "sdk_profile": "k210",
    "binding_strategy": "generated-sdk-adapter",
    "zephyr_root": "third_party/zephyr",
    "board_port": "ports/zephyr-k210",
    "toolchain_variant": "cross-compile",
    "validation": {
      "firmware_build_id": "operation-lambdamart-plan-driven-v2.2-zephyr-native-device",
      "uart_channel": 0,
      "uart_tx_fpioa_io": 7,
      "uart_rx_fpioa_io": 6,
      "gpio_fpioa_io": 8,
      "gpio_binding_pin": 29,
      "gpio_input_fpioa_io": 9,
      "gpio_input_binding_pin": 28,
      "timer_device": 0,
      "timer_channel": 0
    },
    "output": "workspace/generated/k210-zephyr-lambdamart"
  },
  "build": {
    "jobs": 8,
    "max_iterations": 3
  },
  "evaluation": {
    "ground_truth": "experiments/k210-zephyr-ground-truth.json",
    "run_ablations": false
  }
}
