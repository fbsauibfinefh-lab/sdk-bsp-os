{
  "run_id": "simulation-zephyr-native-v0.6",
  "workspace": "workspace",
  "ir_store": "workspace/ir",
  "ingestor": {"mode": "hybrid"},
  "sdk": {
    "id": "kendryte-k210-standalone-sdk-0.5.6",
    "path": "sdk/k210/source"
  },
  "resolver": {
    "capabilities": ["clock", "interrupt", "uart", "gpio", "timer"],
    "threshold": 0.42,
    "top_k": 8,
    "method": "hybrid",
    "model_path": "models/semantic-ranker.txt",
    "hybrid_weight": 0.75
  },
  "toolchain": {
    "architecture": "x86_64",
    "bin": "/usr/bin"
  },
  "closure": {
    "target": {
      "chip": "native_sim",
      "core": "x86_64",
      "startup_policy": "backend",
      "linker_policy": "backend"
    }
  },
  "backend": {
    "type": "zephyr",
    "board": "native_sim/native/64",
    "sdk_profile": "native_sim",
    "zephyr_root": "third_party/zephyr",
    "toolchain_variant": "host",
    "native_executable": true,
    "output": "workspace/generated/simulation-zephyr-native"
  },
  "build": {
    "jobs": 8,
    "max_iterations": 2
  }
}
