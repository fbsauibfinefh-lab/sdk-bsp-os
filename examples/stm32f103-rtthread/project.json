{
  "run_id": "stm32f103-rtthread-lambdamart-v2.5",
  "workspace": "workspace",
  "ir_store": "workspace/ir",
  "ingestor": {"mode": "hybrid"},
  "sdk": {
    "id": "stm32cube-f1",
    "path": "sdk/stm32f103/source"
  },
  "resolver": {
    "method": "operation-lambdamart",
    "model_path": "models/runtime/stm32f103-operation-lambdamart-h03-eq-r1-v2.3.json",
    "binding_decoder": "signature-family",
    "operation_min_margin": 0.0,
    "capabilities": ["clock", "interrupt", "uart", "gpio", "timer"],
    "threshold": 0.42,
    "top_k": 256
  },
  "toolchain": {
    "architecture": "arm",
    "abi": "arm-none-eabi",
    "bin": "toolchains/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin"
  },
  "closure": {
    "target": {
      "chip": "stm32f103",
      "core": "cortex-m3",
      "entry_symbols": ["Reset_Handler"],
      "startup_policy": "backend",
      "linker_policy": "backend"
    }
  },
  "backend": {
    "type": "rtthread",
    "board": "stm32/stm32f103-atk-warshipv3",
    "sdk_profile": "stm32f103",
    "binding_strategy": "native-driver-trace",
    "rtthread_root": "third_party/rt-thread",
    "output": "workspace/generated/stm32f103-rtthread-lambdamart",
    "native_driver_roots": ["bsp/stm32/libraries/HAL_Drivers"],
    "enabled_rtthread_features": [
      "BSP_USING_UART3",
      "BSP_USING_TIM",
      "BSP_USING_TIM2",
      "RT_USING_HWTIMER"
    ],
    "validation": {
      "native_device_validation": true,
      "firmware_build_id": "operation-lambdamart-v2.5-rtthread-native-device",
      "uart": "uart3",
      "uart_pins": {"tx": "PB10", "rx": "PB11"},
      "pin_device": "pin",
      "pin": -1,
      "gpio_output_pin": 16,
      "gpio_input_pin": 17,
      "hwtimer": "timer2"
    },
    "artifacts": {
      "elf": "rt-thread.elf",
      "bin": "rtthread.bin"
    }
  },
  "build": {
    "jobs": 8,
    "max_iterations": 3
  }
}
