{
  "run_id": "psoc-e84-rtthread-lambdamart-v2.4",
  "workspace": "workspace",
  "ir_store": "workspace/ir",
  "ingestor": {"mode": "hybrid"},
  "sdk": {
    "id": "psoc-e84-edgi-talk-sdk",
    "path": "sdk/psoc_e84-edgi-talk/source"
  },
  "resolver": {
    "method": "operation-lambdamart",
    "model_path": "models/runtime/psoc-e84-operation-lambdamart-h03-eq-r1-full-v2.4.json",
    "binding_decoder": "signature-family",
    "operation_min_margin": 0.0,
    "capabilities": ["clock", "interrupt", "uart", "gpio", "timer"],
    "threshold": 0.42,
    "top_k": 1024
  },
  "toolchain": {
    "architecture": "arm",
    "abi": "arm-none-eabi",
    "bin": "toolchains/arm-gnu-toolchain-14.2.rel1-x86_64-arm-none-eabi/bin"
  },
  "closure": {
    "target": {
      "chip": "pse846gps2dbzc4a",
      "core": "cortex-m33",
      "entry_symbols": ["Reset_Handler"],
      "startup_policy": "backend",
      "linker_policy": "backend"
    }
  },
  "backend": {
    "type": "rtthread",
    "board": "psoc_e84-edgi-talk",
    "sdk_profile": "psoc_e84_edgi_talk",
    "binding_strategy": "native-driver-trace",
    "rtthread_root": "third_party/psoc-e84-sdk/rt-thread",
    "project_template": "third_party/psoc-e84-sdk/projects/Edgi_Talk_M33_Template",
    "libraries_root": "third_party/psoc-e84-sdk/libraries",
    "libs_root": "third_party/psoc-e84-sdk/projects/libs",
    "native_driver_roots": ["libraries/HAL_Drivers"],
    "mutable_library_subtrees": ["HAL_Drivers"],
    "output": "workspace/generated/psoc-e84-rtthread-lambdamart",
    "validation": {
      "native_device_validation": true,
      "firmware_build_id": "operation-lambdamart-v2.4-rtthread-native-device",
      "uart": "uart5",
      "pin_device": "pin",
      "pin": -1,
      "gpio_output_pin": 91,
      "gpio_input_pin": 119,
      "hwtimer": "timer0"
    },
    "artifacts": {
      "elf": "rt-thread.elf",
      "bin": "rtthread.hex"
    }
  },
  "build": {
    "jobs": 8,
    "max_iterations": 3
  }
}
